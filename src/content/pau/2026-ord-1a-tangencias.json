      "foldAngle": 0,
      "engines": {
        "plana": {
          "visibles": ["O1", "O2", "T", "C1", "C2"]
        }
      }
    },
    {
      "part": "idea",
      "narration": "Si una circunferencia es tangente a C₂ en T, su centro está en la recta O₂T. Y la tangente común en T es el eje radical de esa circunferencia y C₂.",
      "show3d": [],
      "sheet": [],
      "highlight": [],
      "camera": "front",
      "foldAngle": 0,
      "engines": {
        "plana": {
          "visibles": ["O1", "O2", "T", "C1", "C2", "rO2T", "t"],
          "trazar": ["rO2T", "t"],
          "destacar": ["rO2T"]
        }
      }
    },
    {
      "part": "movimiento",
      "narration": "Imagina que el centro se desliza por la recta O₂T: la circunferencia va cambiando de tamaño y siempre toca a C₂ en T. Solo en dos posiciones toca también a C₁.",
      "show3d": [],
      "sheet": [],
      "highlight": [],
      "camera": "front",
      "foldAngle": 0,
      "engines": {
        "plana": {
          "visibles": ["O1", "O2", "T", "C1", "C2", "rO2T", "t"],
          "destacar": ["rO2T"]
