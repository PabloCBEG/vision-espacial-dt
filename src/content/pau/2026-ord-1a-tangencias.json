      "foldAngle": 0,
      "engines": {
        "plana": {
          "visibles": ["O1", "O2", "T", "C1", "C2", "rO2T", "t", "e", "R"],
          "trazar": ["e", "R"],
          "destacar": ["e"]
        }
      }
    },
    {
      "part": "trazado",
      "narration": "Desde R las tangentes a C₂ miden RT, y las tangentes a C₁ miden lo mismo. La circunferencia de centro R y radio RT corta a C₁ en los puntos de tangencia U₁ y U₂.",
