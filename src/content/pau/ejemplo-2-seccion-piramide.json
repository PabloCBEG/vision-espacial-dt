      "sheet": ["lt", "solido", "corte", "seccion"],
      "highlight": ["seccion"],
      "camera": "perspective",
      "foldAngle": 90,
      "engines": {
        "solidos": {
          "solido": {
            "tipo": "piramide",
            "lados": 6,
            "radio": 22,
            "altura": 52,
            "centro": [0, 32]
          },
          "seccion": {
            "tipo": "proyectante-vertical",
            "puntos": [
              [-35, 6],
              [35, 36]
            ]
          }
        }
      }
    },
    {
      "narration": "Cada punto se lleva a la planta con su línea de referencia, sobre su misma arista. Los lados de la sección en caras ocultas van discontinuos.",
      "show3d": ["planos", "solido", "seccion"],
      "sheet": ["lt", "solido", "corte", "seccion"],
      "highlight": ["seccion"],
      "camera": "top",
      "foldAngle": 90,
      "engines": {
        "solidos": {
          "solido": {
            "tipo": "piramide",
            "lados": 6,
            "radio": 22,
            "altura": 52,
            "centro": [0, 32]
          },
          "seccion": {
            "tipo": "proyectante-vertical",
            "puntos": [
              [-35, 6],
              [35, 36]
            ],
            "quitar": 1
          }
        }
      }
    },
    {
      "narration": "Para la verdadera magnitud se abate α sobre el PV alrededor de α₂. Cada punto queda en la perpendicular a α₂, a una distancia igual a su alejamiento.",
