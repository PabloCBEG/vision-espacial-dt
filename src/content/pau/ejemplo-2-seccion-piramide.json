    "engines": {
      "solidos": {
        "solido": { "tipo": "piramide", "lados": 6, "radio": 22, "altura": 52, "centro": [0, 32] },
        "seccion": {
          "tipo": "proyectante-vertical",
          "puntos": [
            [-35, 6],
            [35, 36]
          ]
        },
        "rotulos": false
      }
    }
  },
  "solucion": [
    {
      "narration": "El plano α es perpendicular al PV: en el alzado se ve de canto. Los puntos de la sección están donde α₂ corta a las aristas laterales.",
