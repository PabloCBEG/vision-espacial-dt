        "solidos": {
          "solido": { "tipo": "piramide", "lados": 5, "radio": 22, "altura": 50, "centro": [0, 32] }
        }
      }
    },
    {
      "narration": "El plano α es proyectante vertical: es perpendicular al PV. Por eso en el alzado se ve de canto, como una recta: su traza α₂.",
      "show3d": ["planos", "solido", "corte"],
      "sheet": ["lt", "solido", "corte"],
      "highlight": ["corte"],
