        }
      }
    },
    {
      "narration": "En la lámina, las aristas vistas van con línea continua gruesa y las ocultas, discontinua fina. Una arista es oculta cuando las dos caras que la forman miran hacia el otro lado.",
      "show3d": ["planos", "solido", "vertices"],
      "sheet": ["lt", "solido", "vertices"],
      "highlight": ["solido"],
      "camera": "front",
